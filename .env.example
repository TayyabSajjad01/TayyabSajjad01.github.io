# Copy to .env.local and enter real values only on the server. Never commit .env.local.
# The form uses an email draft until every email setting below is present.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Exact origin of this Node site, e.g. the local preview or the final HTTPS domain.
PUBLIC_ORIGIN=http://127.0.0.1:4173
# Keep local preview private. Set on the hosting server only when deployment is authorised.
HOST=127.0.0.1
PORT=4173
